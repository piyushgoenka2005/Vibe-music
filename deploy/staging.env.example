# Staging environment template — copy to .env.staging on a staging VPS or branch deploy.
# Never use production DATABASE_URL or Razorpay live keys here.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1

NEXT_PUBLIC_SITE_URL=https://staging.vibemusic.in
AUTH_URL=https://staging.vibemusic.in
NEXTAUTH_URL=https://staging.vibemusic.in

# Separate Neon/Postgres branch or local Docker instance
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibe_staging?schema=public

# Auth — unique secrets per environment
AUTH_SECRET=replace-with-staging-secret-min-32-chars
NEXTAUTH_SECRET=replace-with-staging-secret-min-32-chars
GUEST_ORDER_ACCESS_SECRET=replace-with-staging-guest-secret-min-32

# Razorpay TEST keys only
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_test_xxx

# Optional — same Upstash project with different key prefix, or skip for in-memory limits
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# Ops
METRICS_SCRAPE_TOKEN=
ERROR_MONITORING_WEBHOOK_URL=
GIT_COMMIT_SHA=staging-local
