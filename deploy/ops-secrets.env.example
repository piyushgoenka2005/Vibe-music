# Copy to deploy/ops-secrets.env on the VPS (never commit real values).
# Then run: bash deploy/production.sh certify

# L-30 — Legal entity + GSTIN (footer + invoices; baked at build time)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Sikkim Commerce House Pvt Ltd
NEXT_PUBLIC_GSTIN=

# L-22 — Trust proxy hops when behind nginx on CloudOnFire VPS (rate limits + logs)
TRUST_PROXY_HOPS=1

# Prometheus — Authorization: Bearer <token> on /api/metrics
METRICS_SCRAPE_TOKEN=

# Store phone — 10-digit mobile or with country code (display: +91 891 048 2950)
NEXT_PUBLIC_STORE_PHONE=8910482950
STORE_PHONE=8910482950

# Razorpay — live keys only on production (Dashboard → API Keys)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=
# Webhook URL: https://vibemusic.in/api/payment/webhook/razorpay
# Events: payment.captured, payment.failed, order.paid, refund.processed
# Setup: npm run setup:razorpay-integration  →  npm run ops:sync-razorpay-vps

# Google OAuth (storefront login) — project vibemusic2026
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Redirect: https://vibemusic.in/api/auth/callback/google
# If Google shows "deleted_client", recreate the Web OAuth client (see deploy/README.md).

# Google Analytics 4 — Admin → Data streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_MEASUREMENT_API_SECRET=

# Google Search Console — HTML tag content= value (ownership verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Google Tag Manager (not required when GA4 gtag is configured)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel — Facebook / Instagram ad conversion tracking (Events Manager → Web → Pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=2368094903963199
# META_CAPI_ACCESS_TOKEN=
# META_DOMAIN_VERIFICATION=
# META_TEST_EVENT_CODE=
# NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Optional Google Places — preferred when set; Nominatim India fallback is always on
# GOOGLE_PLACES_API_KEY=

# L-04 — Optional Crisp live chat (footer support widget)
# NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Optional: distributed rate limits (Upstash REST — required for consistent limits across PM2 workers)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Optional rate-limit tuning (see .env.example for full list):
# RATE_LIMIT_MULTIPLIER=1
# RATE_LIMIT_ADMIN_LIMIT=600
# RATE_LIMIT_ADMIN_BULK_IMPORT_LIMIT=40
# RATE_LIMIT_ADMIN_UPLOAD_LIMIT=240
# BACKPRESSURE_ADMIN_MAX=150

# Optional: BullMQ background jobs (Upstash Redis protocol URL — rediss://…)
# REDIS_URL=

# Optional: server error alerts (Slack incoming webhook, Discord, etc.)
# ERROR_MONITORING_WEBHOOK_URL=

# Invoice PDF (requires: npx playwright install chromium)
INVOICE_PDF_ENABLED=true
NEXT_PUBLIC_INVOICE_PDF_ENABLED=true
