# Copy to .env.local for local development (never commit .env.local).
# cp .env.local.example .env.local

# --- Meta Pixel + Conversions API (Events Manager) ---
# 1. Events Manager → Web → Pixel ID (numeric, 15–16 digits)
NEXT_PUBLIC_META_PIXEL_ID=2368094903963199
# 2. Pixel → Settings → Conversions API → Generate access token (server-only)
META_CAPI_ACCESS_TOKEN=
# 3. Business Settings → Domains → vibemusic.in → Meta tag → content= value
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# 4. Optional: Events Manager → Test events → Test event code
# META_TEST_EVENT_CODE=

# After editing, restart: npm run dev
# Verify: npm run verify:meta-integration
