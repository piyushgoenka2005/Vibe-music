# Production environment template (copy to VPS `.env` — never commit real secrets)
# Generate secrets: openssl rand -hex 32

NEXT_PUBLIC_SITE_URL=https://vibemusic.in

# Google Search Console HTML-tag verification (content= value from GSC ownership settings)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

AUTH_SECRET=
# Prefer omitting AUTH_URL (trustHost) OR set the public URL — never localhost
# AUTH_URL=https://vibemusic.in

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google accounts with a verified email matching an existing password account
# are linked automatically. Keep enabled unless a separate authenticated linking
# experience has been implemented.
AUTH_ALLOW_DANGEROUS_EMAIL_LINKING=true
# Google Cloud project (production): vibemusic2026 ("VIBE MUSIC")
# Console: APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# Authorized JavaScript origins:
#   https://vibemusic.in
#   https://www.vibemusic.in
# Authorized redirect URIs:
#   https://vibemusic.in/api/auth/callback/google
#   https://www.vibemusic.in/api/auth/callback/google
# Local (separate or same client):
#   http://localhost:3000
#   http://localhost:3000/api/auth/callback/google

DATABASE_URL=postgresql://vibe:<password>@localhost:5432/vibe?schema=public
# Set during CI/VPS build to pre-render category routes: ALLOW_POSTGRES_DURING_BUILD=true

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_DEMO_PAYMENTS=false

GUEST_ORDER_ACCESS_SECRET=

# Required for admin + customer password reset emails
SMTP_HOST=mail.vibemusic.in
SMTP_PORT=587
SMTP_USER=orders@vibemusic.in
SMTP_PASS=
# Alternative to SMTP_PASS: RESEND_API_KEY=
SMTP_ADMIN_TO=support@vibemusic.in

# Optional invoice PDF downloads (needs Chromium: npx playwright install chromium)
# INVOICE_PDF_ENABLED=true
# NEXT_PUBLIC_INVOICE_PDF_ENABLED=true

CDN_STORAGE_ROOT=/var/www/cdn
CDN_PUBLIC_BASE_URL=https://cdn.vibemusic.in

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Performance (storefront)
# Branded splash on first visit per session; set false for max Lighthouse/CWV scores
NEXT_PUBLIC_ENABLE_PAGE_LOAD_SPLASH=true
# Desktop fluid cursor — disabled on mobile/checkout/auth automatically
NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=true
# PWA: auto-registers in production; set false to disable service worker
# NEXT_PUBLIC_ENABLE_PWA=true

# Storefront phone (digits preferred, with country code). Enables tel: CTAs in help/contact/footer.
# NEXT_PUBLIC_STORE_PHONE=9198XXXXXXXX
# STORE_PHONE=9198XXXXXXXX

# Google Places / Maps (checkout address autocomplete). Enable Places API on the key.
# GOOGLE_PLACES_API_KEY=

# Google Analytics 4 — required for storefront ecommerce + consent banner
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional GTM container (use GA4 OR GTM, or both if you manage tags in GTM)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Server-side purchase events (Measurement Protocol)
GA_MEASUREMENT_API_SECRET=

# Optional: beacon Web Vitals to /api/vitals
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/vitals

# Cart promo thresholds (storefront promo bar / free gift)
# NEXT_PUBLIC_CART_FREE_SHIPPING_THRESHOLD=4999
# NEXT_PUBLIC_CART_FREE_GIFT_THRESHOLD=9999
# NEXT_PUBLIC_CART_GIFT_PRODUCT_ID=

# Newsletter admin inbox ping (optional — footer signup works without this)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Admin alert routing
# ADMIN_NOTIFICATION_EMAIL=support@vibemusic.in

# Reverse proxy (nginx) — set when rate limiting behind a load balancer
# TRUST_PROXY_HOPS=1

# Optional ops webhook for server errors
# ERROR_MONITORING_WEBHOOK_URL=

# GP9 3D model (optional)
# NEXT_PUBLIC_GP9_GLB=true

# Never enable JSON catalog fallback in production
# ALLOW_JSON_CATALOG_FALLBACK=false
