# Production environment template (copy to VPS `.env` — never commit real secrets)
# Generate secrets: openssl rand -hex 32

NEXT_PUBLIC_SITE_URL=https://vibemusic.in
AUTH_SECRET=
# Prefer omitting AUTH_URL (trustHost) OR set the public URL — never localhost
# AUTH_URL=https://vibemusic.in

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google Cloud project (production): vibemusic2026 ("VIBE MUSIC")
# Console: APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# Authorized JavaScript origins:
#   https://vibemusic.in
#   https://www.vibemusic.in
# Authorized redirect URIs:
#   https://vibemusic.in/api/auth/callback/google
#   https://www.vibemusic.in/api/auth/callback/google
# Local (separate or same client):
#   http://localhost:3000
#   http://localhost:3000/api/auth/callback/google

DATABASE_URL=postgresql://vibe:<password>@localhost:5432/vibe?schema=public

NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_DEMO_PAYMENTS=false

GUEST_ORDER_ACCESS_SECRET=

SMTP_HOST=mail.vibemusic.in
SMTP_PORT=587
SMTP_USER=orders@vibemusic.in
SMTP_PASS=
# Alternative to SMTP_PASS: RESEND_API_KEY=
SMTP_ADMIN_TO=support@vibemusic.in

# Optional invoice PDF downloads (needs Chromium: npx playwright install chromium)
# INVOICE_PDF_ENABLED=true
# NEXT_PUBLIC_INVOICE_PDF_ENABLED=true

CDN_STORAGE_ROOT=/var/www/cdn
CDN_PUBLIC_BASE_URL=https://cdn.vibemusic.in

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keep off for launch — reduces first-paint cost
NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=false
NEXT_PUBLIC_ENABLE_PAGE_LOAD_SPLASH=false

# Checkout is online-only unless explicitly enabled
COD_ENABLED=false
