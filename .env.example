NEXT_PUBLIC_SITE_URL=https://vibemusic.in

# Google Search Console — HTML tag verification token (content= value only)
# Search Console → Add property → HTML tag → paste token here, then redeploy.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cart promotions (optional — progress bar always shows; gift auto-add needs product id)
# NEXT_PUBLIC_CART_FREE_SHIPPING_THRESHOLD=400
# NEXT_PUBLIC_CART_FREE_GIFT_THRESHOLD=799
# NEXT_PUBLIC_CART_GIFT_PRODUCT_ID=

# Optional storefront phone (digits preferred, with country code e.g. 9198XXXXXXXX).
# Required for tel: CTAs in Help widget, Contact page, and footer.
NEXT_PUBLIC_STORE_PHONE=

# Auth.js (required in production — AUTH_SECRET min 32 chars)
AUTH_SECRET=
# Optional — set to the public site URL, or omit (trustHost). NEVER use localhost in production.
# AUTH_URL=https://vibemusic.in

# Google OAuth — project vibemusic2026 (VIBE MUSIC) in Google Cloud Console
# https://console.cloud.google.com/apis/credentials?project=vibemusic2026
# Local redirect URI: http://localhost:3000/api/auth/callback/google
# Production redirect URI: https://vibemusic.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opt-in only: allow Google to auto-link to an existing email account without a linking UX.
# AUTH_ALLOW_DANGEROUS_EMAIL_LINKING=true

# PostgreSQL (required in production)
# On the VPS (app + Postgres same host), localhost is correct:
DATABASE_URL=postgresql://vibe:<password>@localhost:5432/vibe?schema=public
# Optional: use Postgres during `next build` SSG (release/CI with a live DB).
# ALLOW_POSTGRES_DURING_BUILD=true
# Local Docker (if 5432 is taken, use 5433):
# DATABASE_URL=postgresql://vibe:<password>@localhost:5433/vibe?schema=public

# VPS CDN storage (required for admin image uploads + WebP derivatives)
# CDN_STORAGE_ROOT=/var/www/cdn
# CDN_PUBLIC_BASE_URL=https://cdn.vibemusic.in

# Razorpay (required in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Never enable in production (startup validation will fail)
ALLOW_DEMO_PAYMENTS=false

# Local JSON under src/data/catalog is a seed/dev mirror. Production serves Postgres only.
# Default: enabled in non-production, disabled in production. Set true only for emergency.
# ALLOW_JSON_CATALOG_FALLBACK=false

# Google Analytics 4 — ecommerce funnel, consent banner, server-side purchase backup
# Create property at https://analytics.google.com — Admin → Data streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional Google Tag Manager (loads alongside or instead of direct gtag)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Server Measurement Protocol secret (Admin → Data streams → Measurement Protocol API secrets)
# Enables purchase events when the browser blocks analytics or user declines consent
GA_MEASUREMENT_API_SECRET=

# Full-screen WebGL fluid cursor on homepage (on by default — set to false to disable)
# NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=false

# Full-screen branded page-load splash (on by default — set to false to disable)
# NEXT_PUBLIC_ENABLE_PAGE_LOAD_SPLASH=false

# GP-9 3D model (optional) — drop public/models/gp9-grand.glb
# unset/auto = use GLB when the file exists; 1 = force try; 0 = always procedural
# NEXT_PUBLIC_GP9_GLB=auto

# Guest order access + invoice signing (required — min 32 chars)
GUEST_ORDER_ACCESS_SECRET=

# Google Places / Maps — checkout address autocomplete (server-only; never required for checkout)
# Canonical: GOOGLE_PLACES_API_KEY
# Aliases also accepted by getGooglePlacesApiKey(): GOOGLE_MAPS_API_KEY,
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY, NEXT_PUBLIC_GOOGLE_PLACES_API_KEY
# Enable Places API for the key in Google Cloud Console (+ billing if required).
# Checkout capability `placesAutocomplete` is true only when a real (non-placeholder) key is present.
# Without a key, checkout falls back to manual address entry (still fully usable).
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PWA — service worker registers in production automatically.
# Set true to also enable during local `npm run dev`.
# NEXT_PUBLIC_ENABLE_PWA=true

# Distributed rate limiting (strongly recommended in production / PM2)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Self-hosted SMTP (required in production — see docs/ops/SMTP.md)
# OR set RESEND_API_KEY to use Resend's SMTP relay instead of SMTP_PASS
SMTP_HOST=mail.vibemusic.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=
# SMTP_SECURE=false
# SMTP_ADMIN_TO=support@vibemusic.in

# Newsletter signup — PostgreSQL via /api/newsletter/subscribe
# Web3Forms optionally notifies your inbox on each signup
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Invoice PDF downloads (optional — HTML + Print always work)
# Requires Chromium on the server via Playwright or Puppeteer:
#   npm i -D playwright && npx playwright install chromium
# Set BOTH flags so the API enables PDF and the order payload includes a pdf URL.
# Partial (server-only) still enables Download PDF once invoiceUrls.pdf is present.
# INVOICE_PDF_ENABLED=true
# NEXT_PUBLIC_INVOICE_PDF_ENABLED=true

# Playwright E2E (local / CI)
# DATABASE_URL required for checkout order persistence tests
# When reusing `npm run dev` during Playwright, set this in .env.local:
DISABLE_RATE_LIMIT=true
# Defaults below match npm run seed:e2e-admin (auto-run via Playwright global setup)
# E2E_ADMIN_EMAIL=e2e-admin@vibemusic.test
# E2E_ADMIN_PASSWORD=E2eAdminPassword!123456
# E2E_CART_VIA_UI=true  # optional — exercise PDP Add to Cart before storage fallback

# Enterprise program seeds (after db:migrate)
# npm run seed:enterprise
# npm run deploy:prep   # migrate + enterprise seeds + validate:ci

# ---- Transactional SMS (MSG91 DLT) � optional, activates when set ----
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ORDER=
MSG91_TEMPLATE_SHIPPED=
MSG91_TEMPLATE_OUT_FOR_DELIVERY=
MSG91_TEMPLATE_DELIVERED=
MSG91_TEMPLATE_CANCELLED=
MSG91_TEMPLATE_REFUND=

# ---- WhatsApp Cloud API (Meta) � optional, activates when set ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER=order_confirmed
WHATSAPP_TEMPLATE_SHIPPED=order_shipped

# ---- Web push (VAPID) � generate: node scripts/ops/generate-vapid-keys.mjs ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vibemusic.in
