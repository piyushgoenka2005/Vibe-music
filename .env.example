NEXT_PUBLIC_SITE_URL=https://vibemusic.in
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server — session cookies + protected routes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (server — signed uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (server)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay (client — publishable key, usually same as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Allow simulated payments when Razorpay keys are absent (dev only — blocked in production)
ALLOW_DEMO_PAYMENTS=

# Full-screen WebGL fluid cursor on homepage (on by default — set to false to disable)
NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=true

# First-visit loading splash overlay (on by default — set to false to skip)
# NEXT_PUBLIC_ENABLE_PAGE_LOAD_SPLASH=false

# Firestore read deadline in ms (per-request fast-fail; default 1200 prod / 350 dev)
# FIRESTORE_DEADLINE_MS=5000

# Startup health probe deadline — increase on slow VPS networks (default 8000 prod)
# FIRESTORE_STARTUP_DEADLINE_MS=15000

# Skip slow Firestore reads when quota is exhausted (optional dev shortcuts)
# DISABLE_FIRESTORE_CATALOG=true
# DISABLE_FIRESTORE_BLOG=true

# Guest order access + invoice signing (min 32 chars — generate a unique production secret)
# Required in production (min 32 chars) — signs guest invoice/order access tokens
GUEST_ORDER_ACCESS_SECRET=
# Optional alias for invoice PDF links (falls back to GUEST_ORDER_ACCESS_SECRET)
# INVOICE_ACCESS_SECRET=

# Google Places (optional — address autocomplete at checkout)
# GOOGLE_PLACES_API_KEY=

# Optional Typesense search (production scale). Falls back to Firestore index when unset.
# TYPESENSE_HOST=https://your-typesense-host
# TYPESENSE_API_KEY=
# TYPESENSE_COLLECTION=products

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional low-stock alert recipient (defaults to ORDER_EMAIL_FROM)
# LOW_STOCK_ALERT_EMAIL=ops@vibemusic.in

# Web Vitals RUM endpoint (defaults to /api/vitals)
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=/api/vitals

# CSRF — comma-separated extra allowed origins (preview/staging domains)
# CSRF_ALLOWED_ORIGINS=https://staging.vibemusic.in

# Firestore read deadline (milliseconds). Production default: 8000
# FIRESTORE_DEADLINE_MS=8000

# Optional server error webhook (Slack/Discord/custom) for production monitoring
# ERROR_MONITORING_WEBHOOK_URL=

# Server cache tuning (seconds / milliseconds)
# CATALOG_CACHE_REVALIDATE_SECONDS=60
# HOMEPAGE_CACHE_REVALIDATE_SECONDS=60
# CATALOG_MEMORY_CACHE_TTL_MS=120000

# Transactional email (Resend — optional in dev)
RESEND_API_KEY=
ORDER_EMAIL_FROM=orders@vibemusic.in
# Newsletter welcome emails (falls back to ORDER_EMAIL_FROM)
NEWSLETTER_EMAIL_FROM=updates@vibemusic.in

# Newsletter signup — subscribers are saved via /api/newsletter/subscribe
# (Firestore when Firebase Admin is configured, otherwise .data/newsletter/).
# Web3Forms optionally notifies your inbox on each signup (client-side key is safe to expose).
# https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Shiprocket logistics (optional — demo mode available in dev)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=400001
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEMO_MODE=true
