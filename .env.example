NEXT_PUBLIC_SITE_URL=https://vibemusic.in

# Auth.js
AUTH_SECRET=
# Optional — defaults to NEXT_PUBLIC_SITE_URL
# AUTH_URL=https://vibemusic.in

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production URI: https://vibemusic.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# VPS CDN storage (new uploads are written here and served by nginx)
# CDN_STORAGE_ROOT=/var/www/cdn
# CDN_PUBLIC_BASE_URL=https://cdn.vibemusic.in

# Razorpay (server)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay (client — publishable key, usually same as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Allow simulated payments when Razorpay keys are absent (dev only — blocked in production)
ALLOW_DEMO_PAYMENTS=

# Full-screen WebGL fluid cursor on homepage (on by default — set to false to disable)
NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=true

# Guest order access + invoice signing (min 32 chars — generate a unique production secret)
GUEST_ORDER_ACCESS_SECRET=

# Google Places (optional — address autocomplete at checkout)
# GOOGLE_PLACES_API_KEY=

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Self-hosted SMTP (see docs/SMTP.md)
SMTP_HOST=mail.vibemusic.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false
# SMTP_ADMIN_TO=support@vibemusic.in

# Newsletter signup — PostgreSQL via /api/newsletter/subscribe
# Web3Forms optionally notifies your inbox on each signup
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# PostgreSQL — self-hosted on the VPS (production) or Docker (local dev)
# Production (app and Postgres on the same VPS — localhost is correct on the server):
# DATABASE_URL=postgresql://vibe:<password>@localhost:5432/vibe?schema=public
# Local Docker dev (if port 5432 is taken, use 5433):
# DATABASE_URL=postgresql://vibe:<password>@localhost:5433/vibe?schema=public

# Shiprocket logistics (optional — demo mode available in dev)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=400001
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEMO_MODE=true
