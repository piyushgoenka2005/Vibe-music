// PostgreSQL schema for Vibe Music (sole production datastore).
// Firestore has been fully decommissioned — do not reintroduce client Firestore reads.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Brand {
  id   String @id
  name String
  slug String @unique

  @@map("brands")
}

model Category {
  id              String  @id
  name            String
  slug            String  @unique
  description     String?
  parentId        String? @map("parent_id")
  imageUrl        String? @map("image_url")
  isFeatured      Boolean @default(false) @map("is_featured")
  sortOrder       Int     @default(0) @map("sort_order")
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  productCount    Int     @default(0) @map("product_count")
  createdAt       String? @map("created_at")
  updatedAt       String? @map("updated_at")

  @@map("categories")
}

model Product {
  id                 String  @id
  slug               String  @unique
  name               String
  brand              String
  category           String
  subcategory        String  @default("")
  price              Float
  originalPrice      Float   @map("original_price")
  discountPercentage Float   @default(0) @map("discount_percentage")
  rating             Float   @default(0)
  reviewCount        Int     @default(0) @map("review_count")
  stock              Int     @default(0)
  stockQuantity      Int?    @map("stock_quantity")
  reservedStock      Int?    @map("reserved_stock")
  lowStockThreshold  Int?    @map("low_stock_threshold")
  sku                String
  status             String  @default("active")
  featured           Boolean @default(false)
  trending           Boolean @default(false)
  newArrival         Boolean @default(false) @map("new_arrival")
  description        String  @default("")
  image              String  @default("")
  imageColor         String  @default("") @map("image_color")
  brandSlug          String  @map("brand_slug")
  categorySlug       String  @map("category_slug")
  availability       String  @default("in-stock")
  condition          String  @default("new")
  gstRate            Int?    @map("gst_rate")
  images             Json    @default("[]")
  specifications     Json    @default("{}")
  detail             Json?
  createdAt          String  @map("created_at")
  updatedAt          String  @map("updated_at")

  @@index([status])
  @@index([categorySlug])
  @@index([brandSlug])
  @@index([featured])
  @@index([trending])
  @@index([newArrival])
  @@map("products")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id                   String  @id
  userId               String? @map("user_id")
  email                String
  trackingToken        String? @map("tracking_token")
  customerName         String? @map("customer_name")
  customerPhone        String? @map("customer_phone")
  isGuestOrder         Boolean @default(false) @map("is_guest_order")
  status               String  @default("pending")
  paymentStatus        String  @default("pending") @map("payment_status")
  paymentMethod        String  @map("payment_method")
  subtotal             Float
  couponCode           String? @map("coupon_code")
  couponDiscount       Float   @default(0) @map("coupon_discount")
  shippingCharge       Float   @default(0) @map("shipping_charge")
  shippingMethod       String? @map("shipping_method")
  platformFee          Float   @default(0) @map("platform_fee")
  totalGst             Float   @default(0) @map("total_gst")
  cgst                 Float   @default(0)
  sgst                 Float   @default(0)
  igst                 Float   @default(0)
  total                Float
  items                Json    @default("[]")
  shippingAddress      Json    @map("shipping_address")
  invoice              Json?
  razorpayOrderId      String? @map("razorpay_order_id")
  razorpayPaymentId    String? @map("razorpay_payment_id")
  razorpaySignature    String? @map("razorpay_signature")
  razorpayRefundId     String? @map("razorpay_refund_id")
  inventoryStatus      String? @map("inventory_status")
  couponUsageApplied   Boolean @default(false) @map("coupon_usage_applied")
  paymentCompletedAt   String? @map("payment_completed_at")
  paymentSource        String? @map("payment_source")
  paymentFailureReason String? @map("payment_failure_reason")
  refundedAt           String? @map("refunded_at")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  shipment       Shipment?
  trackingEvents TrackingEvent[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@map("orders")
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model Review {
  id               String  @id
  productId        String  @map("product_id")
  productName      String  @map("product_name")
  productSlug      String  @map("product_slug")
  userId           String  @map("user_id")
  userEmail        String? @map("user_email")
  author           String
  rating           Int
  title            String  @default("")
  body             String  @default("")
  images           Json    @default("[]")
  hasImages        Boolean @default(false) @map("has_images")
  verifiedPurchase Boolean @default(false) @map("verified_purchase")
  orderId          String? @map("order_id")
  status           String  @default("pending")
  adminReply       String? @map("admin_reply")
  rejectionReason  String? @map("rejection_reason")
  helpfulCount     Int     @default(0) @map("helpful_count")
  createdAt        String  @map("created_at")
  updatedAt        String  @map("updated_at")

  votes ReviewVote[]

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model UserProductReview {
  id        String @id
  userId    String @map("user_id")
  productId String @map("product_id")
  reviewId  String @map("review_id")
  createdAt String @map("created_at")

  @@unique([userId, productId])
  @@map("user_product_reviews")
}

model ReviewVote {
  id        String @id
  reviewId  String @map("review_id")
  userId    String @map("user_id")
  createdAt String @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

model ProductReviewStats {
  productId      String @id @map("product_id")
  totalReviews   Int    @default(0) @map("total_reviews")
  averageRating  Float  @default(0) @map("average_rating")
  distribution   Json   @default("{}")
  verifiedCount  Int    @default(0) @map("verified_count")
  withImagesCount Int   @default(0) @map("with_images_count")
  lastReviewAt   String? @map("last_review_at")
  updatedAt      String @map("updated_at")

  @@map("product_review_stats")
}

// ─── Users & Admins (Auth.js + app profiles) ────────────────────────────────

model User {
  id            String    @id @map("uid")
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?   @map("display_name")
  phone         String?
  dateOfBirth   String?   @map("date_of_birth")
  passwordHash  String?   @map("password_hash")
  image         String?
  isActive      Boolean   @default(true) @map("is_active")
  notificationPreferences Json? @map("notification_preferences")
  createdAt     String    @map("created_at")
  updatedAt     String?   @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  wishlist  Wishlist?
  productCompareList ProductCompareList?

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Admin {
  uid         String  @id
  email       String
  displayName String  @map("display_name")
  role        String
  isActive    Boolean @default(true) @map("is_active")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")
  lastLoginAt String? @map("last_login_at")
  totpSecret  String? @map("totp_secret")
  totpEnabled Boolean @default(false) @map("totp_enabled")

  @@map("admins")
}

model Address {
  id           String  @id
  userId       String  @map("user_id")
  fullName     String  @map("full_name")
  phone        String
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  country      String  @default("India")
  postalCode   String  @map("postal_code")
  isDefault    Boolean @default(false) @map("is_default")
  label        String?
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Wishlist {
  userId    String @id @map("user_id")
  items     Json   @default("[]")
  updatedAt String @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model WishlistShare {
  id        String  @id
  token     String  @unique
  items     Json    @default("[]")
  userId    String? @map("user_id")
  viewCount Int     @default(0) @map("view_count")
  createdAt String  @map("created_at")
  expiresAt String? @map("expires_at")

  @@index([userId])
  @@index([createdAt])
  @@map("wishlist_shares")
}

// ─── Content ────────────────────────────────────────────────────────────────

model Banner {
  id          String  @id
  title       String
  subtitle    String?
  image       String
  mobileImage String? @map("mobile_image")
  ctaText     String  @map("cta_text")
  ctaLink     String  @map("cta_link")
  startDate   String  @map("start_date")
  endDate     String  @map("end_date")
  priority    Int     @default(0)
  status      String  @default("active")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  @@index([status])
  @@map("banners")
}

model BlogPost {
  id             String  @id
  slug           String  @unique
  title          String
  excerpt        String  @default("")
  content        Json
  contentFormat  String  @default("tiptap_json") @map("content_format")
  coverImage     String  @default("") @map("cover_image")
  tags           Json    @default("[]")
  categorySlug   String  @default("") @map("category_slug")
  categoryLabel  String  @default("") @map("category_label")
  featured       Boolean @default(false)
  authorBio      String  @default("") @map("author_bio")
  authorAvatar   String  @default("") @map("author_avatar")
  viewCount      Int     @default(0) @map("view_count")
  seoTitle       String  @default("") @map("seo_title")
  seoDescription String  @default("") @map("seo_description")
  status         String  @default("draft")
  authorId       String  @map("author_id")
  authorName     String  @map("author_name")
  publishedAt    String? @map("published_at")
  scheduledAt    String? @map("scheduled_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  @@index([status])
  @@index([categorySlug])
  @@index([featured])
  @@map("blog_posts")
}

model BlogComment {
  id         String @id
  postId     String @map("post_id")
  authorName String @map("author_name")
  email      String
  body       String
  status     String @default("pending")
  createdAt  String @map("created_at")

  @@index([postId, status])
  @@map("blog_comments")
}

model BlogPostEvent {
  id        String @id
  postId    String? @map("post_id")
  type      String
  metadata  Json   @default("{}")
  createdAt String @map("created_at")

  @@index([type, createdAt])
  @@index([postId])
  @@map("blog_post_events")
}

model HomepageSection {
  id          String @id
  sectionKey  String @unique @map("section_key")
  title       String
  subtitle    String?
  accentLabel String? @map("accent_label")
  ctaText     String? @map("cta_text")
  ctaLink     String? @map("cta_link")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")
  sourceMode  String  @default("auto") @map("source_mode")
  maxItems    Int     @default(8) @map("max_items")
  layout      String  @default("grid")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  items HomepageSectionItem[]

  @@map("homepage_sections")
}

model HomepageSectionItem {
  id           String  @id
  sectionKey   String  @map("section_key")
  sortOrder    Int     @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")
  productId    String? @map("product_id")
  categorySlug String? @map("category_slug")
  brandId      String? @map("brand_id")
  customImage  String? @map("custom_image")
  customTitle  String? @map("custom_title")
  customHref   String? @map("custom_href")
  badgeLabel   String? @map("badge_label")
  offerText    String? @map("offer_text")
  startDate    String? @map("start_date")
  endDate      String? @map("end_date")
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")

  section HomepageSection @relation(fields: [sectionKey], references: [sectionKey], onDelete: Cascade)

  @@index([sectionKey])
  @@map("homepage_section_items")
}

// ─── Commerce ───────────────────────────────────────────────────────────────

model Coupon {
  id              String  @id
  code            String  @unique
  label           String
  type            String
  value           Float
  minOrderAmount  Float?  @map("min_order_amount")
  maxUses         Int?    @map("max_uses")
  usedCount       Int     @default(0) @map("used_count")
  isActive        Boolean @default(true) @map("is_active")
  startsAt        String? @map("starts_at")
  expiresAt       String? @map("expires_at")
  createdAt       String  @map("created_at")
  updatedAt       String  @map("updated_at")

  @@index([isActive])
  @@map("coupons")
}

model StoreSettings {
  id                    String @id @default("store")
  storeName             String @map("store_name")
  storeEmail            String @map("store_email")
  storePhone            String @map("store_phone")
  storeAddress          String @map("store_address")
  gstNumber             String @default("") @map("gst_number")
  defaultGstRate        Int    @map("default_gst_rate")
  sellerState           String @map("seller_state")
  freeShippingThreshold Float  @map("free_shipping_threshold")
  standardShippingCharge Float @map("standard_shipping_charge")
  razorpayEnabled       Boolean @map("razorpay_enabled")
  updatedAt             String @map("updated_at")

  @@map("store_settings")
}

model AdminRolePermissionOverride {
  role        String  @id
  permissions Json    @default("[]")
  updatedAt   String  @map("updated_at")
  updatedBy   String? @map("updated_by")

  @@map("admin_role_permission_overrides")
}

model Shipment {
  id                String  @id
  orderId           String  @unique @map("order_id")
  trackingNumber    String  @map("tracking_number")
  carrier           String
  carrierName       String  @map("carrier_name")
  status            String
  estimatedDelivery String? @map("estimated_delivery")
  shippedAt         String? @map("shipped_at")
  deliveredAt       String? @map("delivered_at")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model TrackingEvent {
  id          String  @id
  shipmentId  String  @map("shipment_id")
  orderId     String  @map("order_id")
  status      String
  title       String
  description String?
  location    String?
  occurredAt  String  @map("occurred_at")
  createdAt   String  @map("created_at")
  actor       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shipmentId])
  @@map("tracking_events")
}

model ReturnRequest {
  id        String  @id
  orderId   String  @map("order_id")
  userId    String? @map("user_id")
  email     String
  reason    String
  details   String?
  status    String  @default("pending")
  adminNote String? @map("admin_note")
  createdAt String  @map("created_at")
  updatedAt String  @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ProductBundle {
  id                String @id
  productId         String @unique @map("product_id")
  productName       String? @map("product_name")
  productSlug       String? @map("product_slug")
  relatedProductIds Json   @default("[]") @map("related_product_ids")
  discountPercent   Float  @default(0) @map("discount_percent")
  isActive          Boolean @default(true) @map("is_active")
  createdAt         String @map("created_at")
  updatedAt         String @map("updated_at")

  @@map("product_bundles")
}

model ProductRelation {
  id                String @id
  productId         String @unique @map("product_id")
  productName       String? @map("product_name")
  productSlug       String? @map("product_slug")
  relatedProductIds Json   @default("[]") @map("related_product_ids")
  isActive          Boolean @default(true) @map("is_active")
  createdAt         String @map("created_at")
  updatedAt         String @map("updated_at")

  @@map("product_relations")
}

model ProductQuestion {
  id          String  @id
  productId   String  @map("product_id")
  productSlug String  @map("product_slug")
  productName String  @map("product_name")
  userId      String? @map("user_id")
  author      String
  question    String
  answer      String?
  answeredBy  String? @map("answered_by")
  status      String  @default("pending")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  @@index([productId])
  @@index([status])
  @@map("product_questions")
}

// ─── Logs & Analytics ───────────────────────────────────────────────────────

model InventoryLog {
  id              String  @id
  productId       String  @map("product_id")
  sku             String
  orderId         String? @map("order_id")
  previousStock   Int     @map("previous_stock")
  newStock        Int     @map("new_stock")
  quantityChanged Int     @map("quantity_changed")
  action          String
  adminId         String? @map("admin_id")
  timestamp       String
  previousReserved Int?   @map("previous_reserved")
  newReserved     Int?    @map("new_reserved")
  note            String?

  @@index([productId])
  @@index([orderId])
  @@map("inventory_logs")
}

model PaymentLog {
  id                String  @id
  razorpayEventId   String  @unique @map("razorpay_event_id")
  eventType         String  @map("event_type")
  status            String
  orderId           String? @map("order_id")
  razorpayOrderId   String? @map("razorpay_order_id")
  razorpayPaymentId String? @map("razorpay_payment_id")
  razorpayRefundId  String? @map("razorpay_refund_id")
  payload           Json    @default("{}")
  error             String?
  attemptCount      Int     @default(0) @map("attempt_count")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")
  processedAt       String? @map("processed_at")

  @@index([orderId])
  @@map("payment_logs")
}

model AuditLog {
  id           String @id @default(cuid())
  action       String
  actorId      String @map("actor_id")
  actorEmail   String @map("actor_email")
  resourceType String @map("resource_type")
  resourceId   String @map("resource_id")
  ip           String @default("")
  userAgent    String @default("") @map("user_agent")
  requestId    String @default("") @map("request_id")
  metadata     Json   @default("{}")
  createdAt    String @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NewsletterSubscriber {
  id           String  @id
  email        String  @unique
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  marketing    Boolean @default(true)
  subscribedAt String  @map("subscribed_at")
  source       String  @default("website")

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String @id
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String @default("new")
  createdAt String @map("created_at")

  @@index([status])
  @@map("contact_messages")
}

model PushSubscription {
  id        String @id
  userId    String @map("user_id")
  endpoint  String @unique
  p256dh    String @map("p256dh")
  auth      String
  userAgent String? @map("user_agent")
  createdAt String @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model ProductStockAlert {
  id          String  @id
  email       String
  productId   String  @map("product_id")
  productSlug String  @map("product_slug")
  productName String  @map("product_name")
  userId      String? @map("user_id")
  createdAt   String  @map("created_at")
  notifiedAt  String? @map("notified_at")

  @@unique([email, productId])
  @@index([productId, notifiedAt])
  @@map("product_stock_alerts")
}

model SearchAnalyticsEvent {
  id        String @id
  query     String
  resultCount Int  @default(0) @map("result_count")
  source    String @default("storefront")
  userId    String? @map("user_id")
  sessionId String? @map("session_id")
  createdAt String @map("created_at")

  @@index([query])
  @@index([createdAt])
  @@map("search_analytics_events")
}

model Counter {
  id    String @id
  value Int    @default(0)

  @@map("counters")
}

model AdminNotification {
  id        String  @id
  type      String
  title     String
  body      String
  link      String?
  read      Boolean @default(false)
  createdAt String  @map("created_at")

  @@index([createdAt])
  @@map("admin_notifications")
}

model UserNotification {
  id        String  @id
  userId    String  @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  read      Boolean @default(false)
  createdAt String  @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("user_notifications")
}

model ShippingZone {
  id                    String  @id
  name                  String
  description           String?
  states                Json    @default("[]")
  pinCodePrefixes       Json    @default("[]") @map("pin_code_prefixes")
  methodCharges         Json    @default("{}") @map("method_charges")
  freeShippingThreshold Float?  @map("free_shipping_threshold")
  isActive              Boolean @default(true) @map("is_active")
  sortOrder             Int     @default(0) @map("sort_order")
  createdAt             String  @map("created_at")
  updatedAt             String  @map("updated_at")

  @@index([isActive])
  @@map("shipping_zones")
}

model SupportTicket {
  id         String  @id
  userId     String? @map("user_id")
  email      String
  name       String
  subject    String
  message    String
  category   String  @default("other")
  orderId    String? @map("order_id")
  status     String  @default("open")
  priority   String  @default("normal")
  adminNote  String? @map("admin_note")
  assignedTo String? @map("assigned_to")
  createdAt  String  @map("created_at")
  updatedAt  String  @map("updated_at")
  resolvedAt String? @map("resolved_at")

  @@index([status])
  @@index([userId])
  @@index([email])
  @@map("support_tickets")
}

model ContentPage {
  slug      String @id
  title     String
  eyebrow   String @default("")
  sections  Json   @default("[]")
  updatedAt String @map("updated_at")

  @@map("content_pages")
}

// ─── Rentals ────────────────────────────────────────────────────────────────

model RentalCategory {
  id              String          @id
  name            String
  slug            String          @unique
  description     String          @default("")
  imageUrl        String?         @map("image_url")
  sortOrder       Int             @default(0) @map("sort_order")
  status          String          @default("active")
  metaTitle       String?         @map("meta_title")
  metaDescription String?         @map("meta_description")
  createdAt       String          @map("created_at")
  updatedAt       String          @map("updated_at")
  products        RentalProduct[]

  @@index([status])
  @@map("rental_categories")
}

model RentalProduct {
  id               String                    @id
  slug             String                    @unique
  name             String
  categoryId       String                    @map("category_id")
  catalogProductId String?                   @map("catalog_product_id")
  description      String                    @default("")
  image            String                    @default("")
  images           Json                      @default("[]")
  specifications   Json                      @default("{}")
  status           String                    @default("active")
  totalUnits       Int                       @default(1) @map("total_units")
  availableUnits   Int                       @default(1) @map("available_units")
  reservedUnits    Int                       @default(0) @map("reserved_units")
  minDurationHours Int                       @default(24) @map("min_duration_hours")
  maxDurationDays  Int                       @default(30) @map("max_duration_days")
  depositAmount    Float                     @default(0) @map("deposit_amount")
  hourlyRate       Float                     @default(0) @map("hourly_rate")
  dailyRate        Float                     @default(0) @map("daily_rate")
  weeklyRate       Float                     @default(0) @map("weekly_rate")
  monthlyRate      Float                     @default(0) @map("monthly_rate")
  pickupAvailable  Boolean                   @default(true) @map("pickup_available")
  deliveryAvailable Boolean                  @default(true) @map("delivery_available")
  deliveryFee      Float                     @default(0) @map("delivery_fee")
  pickupFee        Float                     @default(0) @map("pickup_fee")
  lateFeePerDay    Float                     @default(0) @map("late_fee_per_day")
  damagePolicy     String                    @default("") @map("damage_policy")
  termsText        String                    @default("") @map("terms_text")
  agreementText    String                    @default("") @map("agreement_text")
  featured         Boolean                   @default(false)
  createdAt        String                    @map("created_at")
  updatedAt        String                    @map("updated_at")
  category         RentalCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  units            RentalInventoryUnit[]
  blocks           RentalAvailabilityBlock[]
  bookingItems     RentalBookingItem[]
  inventoryLocks   RentalInventoryLock[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@map("rental_products")
}

model RentalInventoryUnit {
  id           String                @id
  productId    String                @map("product_id")
  serialNumber String?               @map("serial_number")
  label        String                @default("")
  status       String                @default("available")
  createdAt    String                @map("created_at")
  updatedAt    String                @map("updated_at")
  product      RentalProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  locks        RentalInventoryLock[]

  @@index([productId])
  @@index([status])
  @@map("rental_inventory_units")
}

model RentalAvailabilityBlock {
  id        String        @id
  productId String        @map("product_id")
  unitId    String?       @map("unit_id")
  startAt   String        @map("start_at")
  endAt     String        @map("end_at")
  reason    String        @default("maintenance")
  createdAt String        @map("created_at")
  product   RentalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([startAt])
  @@index([endAt])
  @@map("rental_availability_blocks")
}

model RentalBooking {
  id                  String              @id
  bookingNumber       String              @unique @map("booking_number")
  userId              String?             @map("user_id")
  email               String
  customerName        String              @map("customer_name")
  customerPhone       String              @map("customer_phone")
  isGuest             Boolean             @default(false) @map("is_guest")
  status              String              @default("pending")
  paymentStatus       String              @default("pending") @map("payment_status")
  paymentMethod       String?             @map("payment_method")
  durationType        String              @map("duration_type")
  startAt             String              @map("start_at")
  endAt               String              @map("end_at")
  fulfillment         String              @default("pickup")
  address             Json?
  subtotal            Float
  depositAmount       Float               @map("deposit_amount")
  deliveryFee         Float               @default(0) @map("delivery_fee")
  pickupFee           Float               @default(0) @map("pickup_fee")
  totalGst            Float               @default(0) @map("total_gst")
  total               Float
  lateFees            Float               @default(0) @map("late_fees")
  damageCharges       Float               @default(0) @map("damage_charges")
  refundAmount        Float               @default(0) @map("refund_amount")
  agreementAcceptedAt String?             @map("agreement_accepted_at")
  termsAcceptedAt     String?             @map("terms_accepted_at")
  razorpayOrderId     String?             @map("razorpay_order_id")
  razorpayPaymentId   String?             @map("razorpay_payment_id")
  razorpaySignature   String?             @map("razorpay_signature")
  trackingToken       String?             @map("tracking_token")
  cancelledAt         String?             @map("cancelled_at")
  cancellationReason  String?             @map("cancellation_reason")
  returnedAt          String?             @map("returned_at")
  notes               String?
  createdAt           String              @map("created_at")
  updatedAt           String              @map("updated_at")
  items               RentalBookingItem[]
  charges             RentalCharge[]
  events              RentalStatusEvent[]
  locks               RentalInventoryLock[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([startAt])
  @@index([createdAt])
  @@map("rental_bookings")
}

model RentalBookingItem {
  id            String        @id
  bookingId     String        @map("booking_id")
  productId     String        @map("product_id")
  productName   String        @map("product_name")
  productSlug   String        @map("product_slug")
  unitId        String?       @map("unit_id")
  quantity      Int           @default(1)
  durationType  String        @map("duration_type")
  durationUnits Float         @map("duration_units")
  unitRate      Float         @map("unit_rate")
  lineSubtotal  Float         @map("line_subtotal")
  depositAmount Float         @map("deposit_amount")
  booking       RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product       RentalProduct @relation(fields: [productId], references: [id])

  @@index([bookingId])
  @@index([productId])
  @@map("rental_booking_items")
}

model RentalInventoryLock {
  id        String               @id
  unitId    String?              @map("unit_id")
  productId String               @map("product_id")
  bookingId String               @map("booking_id")
  startAt   String               @map("start_at")
  endAt     String               @map("end_at")
  status    String               @default("held")
  expiresAt String?              @map("expires_at")
  createdAt String               @map("created_at")
  booking   RentalBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product   RentalProduct        @relation(fields: [productId], references: [id])
  unit      RentalInventoryUnit? @relation(fields: [unitId], references: [id])

  @@index([productId])
  @@index([bookingId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@map("rental_inventory_locks")
}

model RentalCharge {
  id          String        @id
  bookingId   String        @map("booking_id")
  type        String
  amount      Float
  description String        @default("")
  createdBy   String?       @map("created_by")
  createdAt   String        @map("created_at")
  booking     RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("rental_charges")
}

model RentalStatusEvent {
  id        String        @id
  bookingId String        @map("booking_id")
  status    String
  note      String?
  createdBy String?       @map("created_by")
  createdAt String        @map("created_at")
  booking   RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
  @@map("rental_status_events")
}

model RentalPolicy {
  id                 String @id @default("default")
  title              String @default("Rental Terms")
  termsHtml          String @default("") @map("terms_html")
  agreementHtml      String @default("") @map("agreement_html")
  cancellationPolicy String @default("") @map("cancellation_policy")
  lateFeePolicy      String @default("") @map("late_fee_policy")
  damagePolicy       String @default("") @map("damage_policy")
  updatedAt          String @map("updated_at")

  @@map("rental_policies")
}

// ─── Giveaway Engine ────────────────────────────────────────────────────────

model GiveawayCampaign {
  id                       String                  @id
  slug                     String                  @unique
  title                    String
  subtitle                 String                  @default("")
  description              String                  @default("")
  status                   String                  @default("draft")
  prizeTitle               String                  @map("prize_title")
  prizeDescription         String                  @default("") @map("prize_description")
  prizeImageUrl            String?                 @map("prize_image_url")
  productSlug              String?                 @map("product_slug")
  productName              String?                 @map("product_name")
  prizeValue               Float?                  @map("prize_value")
  winnerCount              Int                     @default(1) @map("winner_count")
  maxEntries               Int?                    @map("max_entries")
  startsAt                 String                  @map("starts_at")
  endsAt                   String                  @map("ends_at")
  drawAt                   String?                 @map("draw_at")
  requireLogin             Boolean                 @default(false) @map("require_login")
  requireEmailVerification Boolean                 @default(true) @map("require_email_verification")
  referralBonusEntries     Int                     @default(1) @map("referral_bonus_entries")
  socialBonusEntries       Int                     @default(1) @map("social_bonus_entries")
  allowedSocialPlatforms   Json                    @default("[\"instagram\",\"youtube\",\"facebook\",\"x\"]") @map("allowed_social_platforms")
  eligibilityRules         Json                    @default("{}") @map("eligibility_rules")
  termsHtml                String                  @default("") @map("terms_html")
  faqs                     Json                    @default("[]")
  featured                 Boolean                 @default(false)
  winnersAnnounced         Boolean                 @default(false) @map("winners_announced")
  createdAt                String                  @map("created_at")
  updatedAt                String                  @map("updated_at")
  entries                  GiveawayEntry[]
  winners                  GiveawayWinner[]
  events                   GiveawayCampaignEvent[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@index([featured])
  @@map("giveaway_campaigns")
}

model GiveawayEntry {
  id                String            @id
  campaignId        String            @map("campaign_id")
  entryNumber       String            @unique @map("entry_number")
  userId            String?           @map("user_id")
  email             String
  customerName      String            @map("customer_name")
  customerPhone     String            @map("customer_phone")
  referralCode      String            @unique @map("referral_code")
  referredByEntryId String?           @map("referred_by_entry_id")
  socialClaims      Json              @default("[]") @map("social_claims")
  baseEntries       Int               @default(1) @map("base_entries")
  bonusEntries      Int               @default(0) @map("bonus_entries")
  totalEntries      Int               @default(1) @map("total_entries")
  emailVerified     Boolean           @default(false) @map("email_verified")
  emailVerifyToken  String?           @unique @map("email_verify_token")
  emailVerifiedAt   String?           @map("email_verified_at")
  status            String            @default("active")
  ipHash            String?           @map("ip_hash")
  userAgentHash     String?           @map("user_agent_hash")
  fraudFlags        Json              @default("[]") @map("fraud_flags")
  trackingToken     String            @unique @map("tracking_token")
  createdAt         String            @map("created_at")
  updatedAt         String            @map("updated_at")
  campaign          GiveawayCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  referredBy        GiveawayEntry?    @relation("GiveawayReferrals", fields: [referredByEntryId], references: [id], onDelete: SetNull)
  referrals         GiveawayEntry[]   @relation("GiveawayReferrals")
  winner            GiveawayWinner?

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([email])
  @@index([userId])
  @@index([referralCode])
  @@index([status])
  @@map("giveaway_entries")
}

model GiveawayWinner {
  id          String           @id
  campaignId  String           @map("campaign_id")
  entryId     String           @unique @map("entry_id")
  rank        Int              @default(1)
  announcedAt String?          @map("announced_at")
  notifiedAt  String?          @map("notified_at")
  createdAt   String           @map("created_at")
  campaign    GiveawayCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entry       GiveawayEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("giveaway_winners")
}

model GiveawayCampaignEvent {
  id         String           @id
  campaignId String           @map("campaign_id")
  type       String
  message    String?
  metadata   Json             @default("{}")
  createdBy  String?          @map("created_by")
  createdAt  String           @map("created_at")
  campaign   GiveawayCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
  @@map("giveaway_campaign_events")
}

// ─── Product Compare ────────────────────────────────────────────────────────

model ProductCompareList {
  userId    String @id @map("user_id")
  items     Json   @default("[]")
  updatedAt String @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("product_compare_lists")
}

model ProductCompareShare {
  id        String  @id
  token     String  @unique
  items     Json    @default("[]")
  userId    String? @map("user_id")
  viewCount Int     @default(0) @map("view_count")
  createdAt String  @map("created_at")
  expiresAt String? @map("expires_at")

  @@index([userId])
  @@index([createdAt])
  @@map("product_compare_shares")
}

model ProductCompareEvent {
  id         String  @id
  eventType  String  @map("event_type")
  userId     String? @map("user_id")
  productId  String? @map("product_id")
  shareToken String? @map("share_token")
  metadata   Json    @default("{}")
  createdAt  String  @map("created_at")

  @@index([eventType])
  @@index([createdAt])
  @@map("product_compare_events")
}
