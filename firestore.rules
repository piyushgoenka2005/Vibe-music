rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Customer profiles — owner read/write only
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Admin profiles — no client access (server Admin SDK only)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Commerce data — all writes via server Admin SDK
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /coupons/{couponId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    match /inventory_adjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /inventory_logs/{logId} {
      allow read, write: if false;
    }

    match /payment_logs/{logId} {
      allow read, write: if false;
    }

    match /addresses/{addressId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /homepage_sections/{sectionId} {
      allow read: if true;
      allow write: if false;
    }

    match /homepage_section_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /product_bundles/{bundleId} {
      allow read: if true;
      allow write: if false;
    }

    match /product_relations/{relationId} {
      allow read: if true;
      allow write: if false;
    }

    match /blog_posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    match /search_analytics_events/{eventId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'store';
      allow write: if false;
    }

    match /analytics/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
