{
  "name": "vibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next-cache.mjs",
    "dev": "next dev",
    "dev:turbo": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:fresh": "node scripts/clean-next-cache.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed:admin": "npx tsx --env-file=.env.local scripts/seed-admin.mts",
    "seed:catalog": "npx tsx --env-file=.env.local scripts/seed-catalog.mts",
    "sync:prisma-env": "node scripts/sync-prisma-env.mjs",
    "sync:homepage": "node scripts/extract-homepage-html.mjs",
    "download:images": "node scripts/download-essential-images.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "download:style-story": "node scripts/download-style-story-thumbnails.mjs",
    "migrate:brand": "node scripts/migrate-brand.mjs && node scripts/migrate-content-brand.mjs",
    "sync:cdn-vps": "powershell -ExecutionPolicy Bypass -File scripts/sync-cdn-to-vps.ps1",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-with-env.mjs migrate dev",
    "db:push": "node scripts/prisma-with-env.mjs db push",
    "db:studio": "node scripts/prisma-with-env.mjs studio",
    "studio": "npm run db:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "verify:integrations": "npx tsx --env-file=.env.local scripts/verify-integrations.mts",
    "validate": "npm run type-check && npm run lint && npm run test && npm run build",
    "validate:ci": "npm run validate && npm run test:e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/html": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tone": "^15.1.22",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "happy-dom": "^20.10.4",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "typescript": "^5",
    "vitest": "^3.2.6",
    "xlsx": "^0.18.5"
  }
}
