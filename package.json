{
  "name": "vibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed:products": "npx tsx --env-file=.env.local scripts/seed-products.mts",
    "seed:admin": "npx tsx --env-file=.env.local scripts/seed-admin.mts",
    "seed:demo": "npx tsx --env-file=.env.local scripts/seed-demo-content.mts",
    "sync:homepage": "node scripts/extract-homepage-html.mjs",
    "download:images": "node scripts/download-essential-images.mjs",
    "download:style-story": "node scripts/download-style-story-thumbnails.mjs",
    "migrate:brand": "node scripts/migrate-brand.mjs && node scripts/migrate-content-brand.mjs",
    "migrate:products": "npx tsx --env-file=.env.local scripts/migrate-products-to-firestore.ts",
    "firebase:deploy-indexes": "npx firebase-tools deploy --only firestore:indexes --project vibe-music-90bb5",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:integrations": "npx tsx --env-file=.env.local scripts/verify-integrations.mts",
    "validate": "npm run type-check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/html": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "adm-zip": "^0.5.17",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
