{
  "name": "vibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/ops/clean-next-cache.mjs",
    "dev": "node --no-deprecation ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "node --no-deprecation ./node_modules/next/dist/bin/next dev",
    "dev:webpack": "node --no-deprecation ./node_modules/next/dist/bin/next dev --webpack",
    "dev:fresh": "node scripts/ops/clean-next-cache.mjs && node --no-deprecation ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed:admin": "npx tsx --env-file=.env.local scripts/db/seed-admin.mts",
    "seed:admin-credentials": "npx tsx --env-file=.env.local scripts/db/ensure-admin-credentials.mts",
    "seed:e2e-admin": "npx tsx scripts/db/seed-e2e-admin.mts",
    "seed:catalog": "npx tsx --env-file=.env.local scripts/catalog/seed-catalog.mts",
    "generate:reviews": "npx tsx scripts/catalog/generate-synthetic-reviews.mts",
    "seed:reviews": "npx tsx --env-file=.env.local scripts/catalog/seed-reviews.mts",
    "seed:rentals": "npx tsx --env-file=.env.local scripts/catalog/seed-rentals.mts",
    "seed:finance": "npx tsx --env-file=.env.local scripts/catalog/seed-finance.mts",
    "seed:giveaway": "npx tsx --env-file=.env.local scripts/catalog/seed-giveaway.mts",
    "seed:blog": "npx tsx --env-file=.env.local scripts/catalog/seed-blog.mts",
    "seed:enterprise": "npm run seed:rentals && npm run seed:finance && npm run seed:giveaway && npm run seed:blog",
    "deploy:prep": "npm run db:migrate && npm run seed:enterprise && npm run validate:ci",
    "sync:prisma-env": "node scripts/db/sync-prisma-env.mjs",
    "sync:homepage": "node scripts/legacy/extract-homepage-html.mjs",
    "download:images": "node scripts/assets/download-essential-images.mjs",
    "generate:favicons": "node scripts/assets/generate-favicons.mjs",
    "download:style-story": "node scripts/assets/download-style-story-thumbnails.mjs",
    "migrate:brand": "node scripts/legacy/migrate-brand.mjs && node scripts/legacy/migrate-content-brand.mjs",
    "sync:cdn-vps": "powershell -ExecutionPolicy Bypass -File scripts/ops/sync-cdn-to-vps.ps1",
    "postinstall": "node scripts/db/prisma-generate.mjs",
    "db:generate": "node scripts/db/prisma-generate.mjs",
    "db:migrate": "node scripts/db/prisma-with-env.mjs migrate deploy",
    "db:migrate:dev": "node scripts/db/prisma-with-env.mjs migrate dev",
    "db:push": "node scripts/db/prisma-with-env.mjs db push",
    "db:studio": "node scripts/db/prisma-with-env.mjs studio",
    "studio": "npm run db:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report playwright-report",
    "audit:lighthouse": "node scripts/ops/lighthouse-audit.mjs",
    "verify:integrations": "npx tsx --env-file=.env.local scripts/ops/verify-integrations.mts",
    "check:env": "node scripts/ops/check-env.mjs",
    "setup:local": "node scripts/db/setup-local-config.mjs",
    "db:probe": "node scripts/db/probe-db.mjs",
    "validate": "npm run type-check && npm run lint && npm run test && npm run build",
    "validate:ci": "npm run validate && npm run test:e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/html": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tone": "^15.1.22",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "happy-dom": "^20.10.4",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "typescript": "^5",
    "vitest": "^3.2.6",
    "xlsx": "^0.18.5"
  }
}
