NEXT_PUBLIC_SITE_URL=https://vibemusic.in
NEXT_PUBLIC_CDN_PUBLIC_BASE_URL=https://cdn.vibemusic.in
NEXT_PUBLIC_API_URL=https://vibemusic.in
NEXT_PUBLIC_ENABLE_PAGE_LOAD_SPLASH=false
NEXT_PUBLIC_ENABLE_SPLASH_CURSOR=false
DISABLE_RATE_LIMIT=false

# ── Rate-limit overrides (raise limits to production scale) ─────────────────
RATE_LIMIT_PUBLIC_API_LIMIT=500
RATE_LIMIT_AUTH_LIMIT=100
RATE_LIMIT_VITALS_LIMIT=200
RATE_LIMIT_ANALYTICS_LIMIT=100
RATE_LIMIT_SEARCH_LIMIT=100
RATE_LIMIT_PRODUCTS_TRENDING_LIMIT=200
RATE_LIMIT_MULTIPLIER=1

# ── Back-pressure limits (prevent concurrent-request 504s) ──────────────────
BACKPRESSURE_API_MAX=500
BACKPRESSURE_AUTH_MAX=200
BACKPRESSURE_SEARCH_MAX=200
BACKPRESSURE_MEDIA_THUMB_MAX=900
BACKPRESSURE_ADMIN_MAX=300

# ── Razorpay live key pair (required for checkout) ──────────────────────────
# Replace YOUR_LIVE_KEY_ID with your actual key from the Razorpay dashboard.
# Both values MUST match and start with rzp_live_.
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID

# ── Google OAuth (required for "Continue with Google" button) ───────────────
# Replace with your real Google Cloud Console credentials.
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
